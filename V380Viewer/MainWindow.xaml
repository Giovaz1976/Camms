<Window x:Class="V380Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="V380 Camera Viewer - Local Network" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Panel -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnScanCameras" Content="🔍 Scan Cameras" 
                            Width="120" Height="35" Margin="5" Click="BtnScanCameras_Click"
                            Background="#3498DB" Foreground="White" BorderThickness="0"
                            FontWeight="Bold" Cursor="Hand"/>
                    <Button x:Name="BtnAddCamera" Content="➕ Add Camera" 
                            Width="110" Height="35" Margin="5" Click="BtnAddCamera_Click"
                            Background="#16A085" Foreground="White" BorderThickness="0"
                            FontWeight="Bold" Cursor="Hand"/>
                    <Button x:Name="BtnQuality" Content="⚙️ HD" 
                            Width="70" Height="35" Margin="5" Click="BtnQuality_Click"
                            Background="#9B59B6" Foreground="White" BorderThickness="0"
                            FontWeight="Bold" Cursor="Hand" ToolTip="Toggle stream quality (HD/SD)"/>
                    <TextBlock x:Name="TxtStatus" Text="Ready" VerticalAlignment="Center" 
                               Margin="15,0,0,0" Foreground="White" FontSize="14"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Layout:" VerticalAlignment="Center" Foreground="White" Margin="5,0"/>
                    <Button x:Name="BtnLayout1" Content="1" Width="35" Height="35" Margin="2" 
                            Click="BtnLayout1_Click" Background="#27AE60" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="Single camera"/>
                    <Button x:Name="BtnLayout2" Content="2" Width="35" Height="35" Margin="2" 
                            Click="BtnLayout2_Click" Background="#34495E" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="2 cameras side by side"/>
                    <Button x:Name="BtnLayout4" Content="4" Width="35" Height="35" Margin="2" 
                            Click="BtnLayout4_Click" Background="#34495E" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="2x2 grid"/>
                    <Button x:Name="BtnLayout9" Content="9" Width="35" Height="35" Margin="2" 
                            Click="BtnLayout9_Click" Background="#34495E" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="3x3 grid"/>
                    <Button x:Name="BtnShowPtz" Content="🎮 PTZ" Width="70" Height="35" Margin="15,2,5,2" 
                            Click="BtnShowPtz_Click" MouseRightButtonDown="BtnShowPtz_Click"
                            Background="#8E44AD" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="Left-click: Show/Hide PTZ | Right-click: Configure credentials"/>
                    <Button x:Name="BtnExit" Content="✕ Exit" Width="80" Height="35" Margin="5,2,2,2" 
                            Click="BtnExit_Click" Background="#E74C3C" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="Close application"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Camera List -->
            <Border Grid.Column="0" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Discovered Cameras" 
                               FontWeight="Bold" FontSize="14" Margin="10"
                               Foreground="#2C3E50"/>
                    
                    <ListBox x:Name="LstCameras" Grid.Row="1" Margin="5"
                             SelectionMode="Multiple"
                             Background="White" BorderThickness="0"
                             SelectionChanged="LstCameras_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="⚙️ Configure Credentials" Click="MenuConfigureCredentials_Click"/>
                                <Separator/>
                                <MenuItem Header="🗑️ Remove Camera" Click="MenuRemoveCamera_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{Binding DeviceId}" FontSize="10" Foreground="#95A5A6"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            
            <!-- Video Display Grid with PTZ Controls -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Video Display -->
                <Border Grid.Column="0" Background="#252525">
                    <Grid x:Name="VideoGrid">
                        <TextBlock x:Name="TxtVideoStatus" 
                                   Text="Select one or more cameras to start viewing"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </Grid>
                </Border>
                
                <!-- PTZ Control Panel -->
                <Border Grid.Column="1" Background="#2C3E50" Width="180" 
                        x:Name="PtzPanel" Visibility="Collapsed">
                    <StackPanel Margin="10">
                        <TextBlock Text="PTZ Control" FontWeight="Bold" FontSize="14" 
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        
                        <!-- Pan/Tilt Controls -->
                        <TextBlock Text="Pan/Tilt" FontSize="11" Foreground="#95A5A6" Margin="0,0,0,5"/>
                        <Grid Height="120" Width="120" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <!-- Up -->
                            <Button x:Name="BtnPtzUp" Content="▲" Width="40" Height="40"
                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                    Background="#3498DB" Foreground="White" BorderThickness="0"
                                    FontSize="18" FontWeight="Bold" Cursor="Hand"
                                    PreviewMouseDown="BtnPtzUp_MouseDown" 
                                    PreviewMouseUp="BtnPtz_MouseUp"/>
                            <!-- Down -->
                            <Button x:Name="BtnPtzDown" Content="▼" Width="40" Height="40"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Background="#3498DB" Foreground="White" BorderThickness="0"
                                    FontSize="18" FontWeight="Bold" Cursor="Hand"
                                    PreviewMouseDown="BtnPtzDown_MouseDown" 
                                    PreviewMouseUp="BtnPtz_MouseUp"/>
                            <!-- Left -->
                            <Button x:Name="BtnPtzLeft" Content="◄" Width="40" Height="40"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="#3498DB" Foreground="White" BorderThickness="0"
                                    FontSize="18" FontWeight="Bold" Cursor="Hand"
                                    PreviewMouseDown="BtnPtzLeft_MouseDown" 
                                    PreviewMouseUp="BtnPtz_MouseUp"/>
                            <!-- Right -->
                            <Button x:Name="BtnPtzRight" Content="►" Width="40" Height="40"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#3498DB" Foreground="White" BorderThickness="0"
                                    FontSize="18" FontWeight="Bold" Cursor="Hand"
                                    PreviewMouseDown="BtnPtzRight_MouseDown" 
                                    PreviewMouseUp="BtnPtz_MouseUp"/>
                            <!-- Home/Center -->
                            <Button x:Name="BtnPtzHome" Content="⊙" Width="35" Height="35"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#95A5A6" Foreground="White" BorderThickness="0"
                                    FontSize="16" FontWeight="Bold" Cursor="Hand"
                                    Click="BtnPtzHome_Click" ToolTip="Return to home position"/>
                        </Grid>
                        
                        <!-- Zoom Controls -->
                        <TextBlock Text="Zoom" FontSize="11" Foreground="#95A5A6" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnZoomIn" Content="🔍+" Grid.Column="0" Height="40" Margin="0,0,5,0"
                                    Background="#27AE60" Foreground="White" BorderThickness="0"
                                    FontSize="16" FontWeight="Bold" Cursor="Hand"
                                    PreviewMouseDown="BtnZoomIn_MouseDown" 
                                    PreviewMouseUp="BtnPtz_MouseUp"/>
                            <Button x:Name="BtnZoomOut" Content="🔍-" Grid.Column="1" Height="40" Margin="5,0,0,0"
                                    Background="#E67E22" Foreground="White" BorderThickness="0"
                                    FontSize="16" FontWeight="Bold" Cursor="Hand"
                                    PreviewMouseDown="BtnZoomOut_MouseDown" 
                                    PreviewMouseUp="BtnPtz_MouseUp"/>
                        </Grid>
                        
                        <!-- Speed Control -->
                        <TextBlock Text="Speed" FontSize="11" Foreground="#95A5A6" Margin="0,0,0,5"/>
                        <Slider x:Name="SliderPtzSpeed" Minimum="0.1" Maximum="1.0" Value="0.5" 
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtPtzSpeed" Text="Speed: 0.5" FontSize="10" 
                                   Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                        
                        <!-- Test PTZ Button -->
                        <Button x:Name="BtnTestPtz" Content="🔧 Test PTZ" Height="30" Margin="0,10,0,5"
                                Background="#3498DB" Foreground="White" BorderThickness="0"
                                FontSize="11" FontWeight="Bold" Cursor="Hand"
                                Click="BtnTestPtz_Click" ToolTip="Test if camera supports PTZ"/>
                        
                        <!-- Debug PTZ Button -->
                        <Button x:Name="BtnDebugPtz" Content="🐛 Show SOAP" Height="25" Margin="0,0,0,5"
                                Background="#95A5A6" Foreground="White" BorderThickness="0"
                                FontSize="10" FontWeight="Bold" Cursor="Hand"
                                Click="BtnDebugPtz_Click" ToolTip="Show SOAP commands"/>
                        
                        <!-- Toggle PTZ Panel Button -->
                        <Button x:Name="BtnTogglePtz" Content="Hide PTZ" Height="30" Margin="0,5,0,0"
                                Background="#E74C3C" Foreground="White" BorderThickness="0"
                                FontSize="11" FontWeight="Bold" Cursor="Hand"
                                Click="BtnTogglePtz_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        
        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="TxtConnectionInfo" Grid.Column="0" 
                           Text="Not connected" Foreground="White" FontSize="12"/>
                <TextBlock x:Name="TxtFps" Grid.Column="1" 
                           Text="FPS: 0" Foreground="#3498DB" FontSize="12" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
