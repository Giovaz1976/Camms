<Window x:Class="V380Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="V380 Camera Viewer - Local Network" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Panel -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnScanCameras" Content="🔍 Scan Cameras" 
                            Width="120" Height="35" Margin="5" Click="BtnScanCameras_Click"
                            Background="#3498DB" Foreground="White" BorderThickness="0"
                            FontWeight="Bold" Cursor="Hand"/>
                    <TextBlock x:Name="TxtStatus" Text="Ready" VerticalAlignment="Center" 
                               Margin="15,0,0,0" Foreground="White" FontSize="14"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Layout:" VerticalAlignment="Center" Foreground="White" Margin="5,0"/>
                    <Button x:Name="BtnLayout1" Content="1" Width="35" Height="35" Margin="2" 
                            Click="BtnLayout1_Click" Background="#27AE60" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="Single camera"/>
                    <Button x:Name="BtnLayout2" Content="2" Width="35" Height="35" Margin="2" 
                            Click="BtnLayout2_Click" Background="#34495E" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="2 cameras side by side"/>
                    <Button x:Name="BtnLayout4" Content="4" Width="35" Height="35" Margin="2" 
                            Click="BtnLayout4_Click" Background="#34495E" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="2x2 grid"/>
                    <Button x:Name="BtnLayout9" Content="9" Width="35" Height="35" Margin="2" 
                            Click="BtnLayout9_Click" Background="#34495E" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="3x3 grid"/>
                    <Button x:Name="BtnExit" Content="✕ Exit" Width="80" Height="35" Margin="15,2,2,2" 
                            Click="BtnExit_Click" Background="#E74C3C" Foreground="White" 
                            BorderThickness="0" FontWeight="Bold" ToolTip="Close application"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Camera List -->
            <Border Grid.Column="0" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Discovered Cameras" 
                               FontWeight="Bold" FontSize="14" Margin="10"
                               Foreground="#2C3E50"/>
                    
                    <ListBox x:Name="LstCameras" Grid.Row="1" Margin="5"
                             SelectionMode="Multiple"
                             Background="White" BorderThickness="0"
                             SelectionChanged="LstCameras_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{Binding DeviceId}" FontSize="10" Foreground="#95A5A6"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            
            <!-- Video Display Grid -->
            <Border Grid.Column="1" Background="#252525">
                <Grid x:Name="VideoGrid">
                    <TextBlock x:Name="TxtVideoStatus" 
                               Text="Select one or more cameras to start viewing"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="TxtConnectionInfo" Grid.Column="0" 
                           Text="Not connected" Foreground="White" FontSize="12"/>
                <TextBlock x:Name="TxtFps" Grid.Column="1" 
                           Text="FPS: 0" Foreground="#3498DB" FontSize="12" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
